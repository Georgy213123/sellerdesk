<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ToBe" targetNamespace="https://example.org/sellerdesk/bpmn" exporter="handwritten" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ToBe">
    <bpmn:participant id="Pool_ToBe" name="Обработка обращения покупателя в SellerDesk" processRef="Process_ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBe">
      <bpmn:lane id="Lane_buyer" name="Покупатель">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_mp" name="Площадка">
        <bpmn:flowNodeRef>Store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sd" name="SellerDesk">
        <bpmn:flowNodeRef>Sync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Render</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwVars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_op" name="Оператор">
        <bpmn:flowNodeRef>Feed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwHow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Покупатель написал">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Store" name="Хранить обращение">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Sync" name="Фоновая синхронизация: upsert по внешнему id">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Feed" name="Отфильтровать ленту и открыть чат">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwHow" name="Как отвечаем?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Draft" name="Сформировать AI-черновик">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Render" name="Подставить переменные шаблона">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwVars" name="Все переменные подставились?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Review" name="Проверить и поправить текст">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Send" name="Отправить с ключом идемпотентности">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Deliver" name="Принять ответ">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Покупатель получил один ответ">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Store" />
    <bpmn:sequenceFlow id="F2" sourceRef="Store" targetRef="Sync" />
    <bpmn:sequenceFlow id="F3" sourceRef="Sync" targetRef="Feed" />
    <bpmn:sequenceFlow id="F4" sourceRef="Feed" targetRef="GwHow" />
    <bpmn:sequenceFlow id="F5" name="AI-черновик" sourceRef="GwHow" targetRef="Draft" />
    <bpmn:sequenceFlow id="F6" name="вручную" sourceRef="GwHow" targetRef="Review" />
    <bpmn:sequenceFlow id="F7" sourceRef="Draft" targetRef="Review" />
    <bpmn:sequenceFlow id="F8" name="шаблон" sourceRef="GwHow" targetRef="Render" />
    <bpmn:sequenceFlow id="F9" sourceRef="Render" targetRef="GwVars" />
    <bpmn:sequenceFlow id="F10" name="да" sourceRef="GwVars" targetRef="Send" />
    <bpmn:sequenceFlow id="F11" name="нет: черновик с причиной" sourceRef="GwVars" targetRef="Review" />
    <bpmn:sequenceFlow id="F12" sourceRef="Review" targetRef="Send" />
    <bpmn:sequenceFlow id="F13" sourceRef="Send" targetRef="Deliver" />
    <bpmn:sequenceFlow id="F14" sourceRef="Deliver" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ToBe">
    <bpmndi:BPMNPlane id="Plane_ToBe" bpmnElement="Collab_ToBe">
      <bpmndi:BPMNShape id="Pool_ToBe_di" bpmnElement="Pool_ToBe" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2130" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_buyer_di" bpmnElement="Lane_buyer" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2100" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_mp_di" bpmnElement="Lane_mp" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="2100" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_sd_di" bpmnElement="Lane_sd" isHorizontal="true">
        <dc:Bounds x="190" y="380" width="2100" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_op_di" bpmnElement="Lane_op" isHorizontal="true">
        <dc:Bounds x="190" y="530" width="2100" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="232" y="137" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Store_di" bpmnElement="Store">
        <dc:Bounds x="360" y="265" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sync_di" bpmnElement="Sync">
        <dc:Bounds x="530" y="415" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Feed_di" bpmnElement="Feed">
        <dc:Bounds x="700" y="565" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwHow_di" bpmnElement="GwHow" isMarkerVisible="true">
        <dc:Bounds x="905" y="580" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Draft_di" bpmnElement="Draft">
        <dc:Bounds x="1040" y="415" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Render_di" bpmnElement="Render">
        <dc:Bounds x="1210" y="415" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwVars_di" bpmnElement="GwVars" isMarkerVisible="true">
        <dc:Bounds x="1415" y="430" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Review_di" bpmnElement="Review">
        <dc:Bounds x="1550" y="565" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Send_di" bpmnElement="Send">
        <dc:Bounds x="1720" y="415" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Deliver_di" bpmnElement="Deliver">
        <dc:Bounds x="1890" y="265" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="2102" y="137" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="268" y="155" />
        <di:waypoint x="314" y="155" />
        <di:waypoint x="314" y="305" />
        <di:waypoint x="360" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="480" y="305" />
        <di:waypoint x="505" y="305" />
        <di:waypoint x="505" y="455" />
        <di:waypoint x="530" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="650" y="455" />
        <di:waypoint x="675" y="455" />
        <di:waypoint x="675" y="605" />
        <di:waypoint x="700" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="820" y="605" />
        <di:waypoint x="905" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="955" y="605" />
        <di:waypoint x="997" y="605" />
        <di:waypoint x="997" y="455" />
        <di:waypoint x="1040" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="955" y="605" />
        <di:waypoint x="1550" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="1160" y="455" />
        <di:waypoint x="1355" y="455" />
        <di:waypoint x="1355" y="605" />
        <di:waypoint x="1550" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="955" y="605" />
        <di:waypoint x="1082" y="605" />
        <di:waypoint x="1082" y="455" />
        <di:waypoint x="1210" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1330" y="455" />
        <di:waypoint x="1415" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="1465" y="455" />
        <di:waypoint x="1720" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="1465" y="455" />
        <di:waypoint x="1507" y="455" />
        <di:waypoint x="1507" y="605" />
        <di:waypoint x="1550" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12">
        <di:waypoint x="1670" y="605" />
        <di:waypoint x="1695" y="605" />
        <di:waypoint x="1695" y="455" />
        <di:waypoint x="1720" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13">
        <di:waypoint x="1840" y="455" />
        <di:waypoint x="1865" y="455" />
        <di:waypoint x="1865" y="305" />
        <di:waypoint x="1890" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14">
        <di:waypoint x="2010" y="305" />
        <di:waypoint x="2056" y="305" />
        <di:waypoint x="2056" y="155" />
        <di:waypoint x="2102" y="155" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
