{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)"
    ],
    "allow": [
      "Bash(make lint:*)",
      "Bash(make test:*)",
      "Bash(make e2e:*)",
      "Bash(uv run pytest:*)",
      "Bash(npm run:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": ".claude/hooks/block-secrets.sh" }]
      }
    ]
  },
  "enabledMcpjsonServers": ["playwright"]
}
