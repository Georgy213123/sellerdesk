# Фиктивные значения для демо-стенда. Настоящих ключей в репозитории нет.
DATABASE_URL=postgresql+psycopg://sellerdesk:sellerdesk@localhost:55101/sellerdesk
JWT_SECRET=demo-only-change-me-0123456789abcdef
DEMO_OPERATOR_LOGIN=operator
DEMO_OPERATOR_PASSWORD=demo-password

# mock — заглушки площадок; real — адаптеры из app/marketplaces/real.py (в демо не реализованы)
MARKETPLACE_MODE=mock
MOCK_MARKETPLACE_DELAY_MS=800
MOCK_SEED=42
LLM_PROVIDER=stub

# Нужны только при MARKETPLACE_MODE=real
WB_API_TOKEN=
OZON_API_KEY=
YANDEX_MARKET_TOKEN=

# Задача синхронизации, не завершившаяся за это время, считается прерванной
SYNC_JOB_STALE_AFTER_S=600
